#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# Instalar root:root, modo 0755 en /usr/local/libexec. Nunca se ejecuta la GUI como root.
set -euo pipefail
if [[ $EUID -ne 0 ]]; then
    echo 'Se requieren privilegios de administrador (pkexec).' >&2
    exit 1
fi
if [[ $# -ne 2 ]]; then
    echo 'Uso: tuf-control-helper {turbo on|off|battery N}' >&2
    exit 2
fi
case "$1" in
    turbo)
        case "$2" in on|off) ;; *) echo 'Valor inválido' >&2; exit 2;; esac
        # Usar el mismo gestor que systemd: cambiar y guardar siempre juntos.
        # Ruta absoluta y estados estrictamente validados; no acepta comandos arbitrarios.
        exec /usr/local/bin/tuf-control-boost set "$2"
        ;;
    battery)
        [[ "$2" =~ ^[0-9]{2,3}$ ]] || { echo 'Valor inválido' >&2; exit 2; }
        value=$((10#$2))
        (( value >= 40 && value <= 100 )) || { echo 'Fuera de rango: 40-100' >&2; exit 2; }
        found=0
        for path in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
            [[ -f "$path" ]] || continue
            printf '%s\n' "$value" > "$path"
            found=1
            break
        done
        [[ "$found" -eq 1 ]] || { echo 'No existe control de límite de batería.' >&2; exit 3; }
        echo "Límite de batería: $value%"
        ;;
    *) echo 'Operación no permitida' >&2; exit 2;;
esac
